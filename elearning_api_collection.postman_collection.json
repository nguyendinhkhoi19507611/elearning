  "item": [
    {
      "name": "🔐 Auth",
      "description": "Xác thực: Đăng ký, Đăng nhập, OTP, Đổi mật khẩu",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register"
            },
            "description": "Tạo tài khoản mới",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@test.com\",\n  \"password\": \"123456\",\n  \"role\": \"student\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d=pm.response.json();",
                  "pm.test('Status 201',()=>pm.response.to.have.status(201));",
                  "if(d.token) pm.collectionVariables.set('token',d.token);",
                  "if(d.user?._id) pm.collectionVariables.set('userId',d.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login"
            },
            "description": "Đăng nhập Admin — token tự động lưu",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@elearning.com\",\n  \"password\": \"123456\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d=pm.response.json();",
                  "pm.test('Status 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Has token',()=>pm.expect(d.token).to.be.a('string'));",
                  "if(d.token) pm.collectionVariables.set('token',d.token);",
                  "if(d.user?._id) pm.collectionVariables.set('userId',d.user._id);"
                ]
              }
            }
          ]
        },
